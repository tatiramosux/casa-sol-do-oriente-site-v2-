# ID exibido em Google Agenda > Configurações > Integrar agenda
GOOGLE_CALENDAR_ID=casasoldooriente@gmail.com

# E-mail da conta de serviço criada no Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=calendario-site@seu-projeto.iam.gserviceaccount.com

# Chave privada do JSON, mantendo os caracteres \\n dentro do valor
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nSUA_CHAVE_AQUI\\n-----END PRIVATE KEY-----\\n"

# Alternativa aos dois campos acima: JSON completo convertido para Base64
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

GOOGLE_CALENDAR_TIME_ZONE=America/Sao_Paulo

# URL canônica usada no sitemap, robots, Open Graph e dados estruturados
NEXT_PUBLIC_SITE_URL=https://www.casasoldooriente.com.br

# Google Analytics 4 > Administrador > Fluxos de dados > Web (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console > verificação por tag HTML (somente o conteúdo da chave)
GOOGLE_SITE_VERIFICATION=
